{
  "uid": "cloudshield", "title": "CloudShield KooLab - Security & Load", "schemaVersion": 40, "version": 1,
  "time": {"from": "now-30m", "to": "now"}, "refresh": "5s", "tags": ["huawei", "koolab", "security"],
  "panels": [
    {"id": 1, "title": "Request rate (per second)", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "cloudshield-prom"}, "targets": [{"expr": "sum(rate(cloudshield_requests_total[1m]))", "refId": "A", "legendFormat": "requests/sec"}]},
    {"id": 2, "title": "Blocked requests", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "cloudshield-prom"}, "targets": [{"expr": "sum by (engine) (increase(cloudshield_blocks_total[5m]))", "refId": "A", "legendFormat": "{{engine}}"}]},
    {"id": 3, "title": "Target HTTP statuses", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9}, "datasource": {"type": "prometheus", "uid": "cloudshield-prom"}, "targets": [{"expr": "sum by (status) (rate(cloudshield_requests_total[1m]))", "refId": "A", "legendFormat": "HTTP {{status}}"}]},
    {"id": 4, "title": "Request latency p95 (seconds)", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9}, "datasource": {"type": "prometheus", "uid": "cloudshield-prom"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(cloudshield_request_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p95"}]}
  ]
}
